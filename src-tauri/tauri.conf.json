{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laika",
  "version": "0.1.0",
  "identifier": "com.codenour.laika",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Laika",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Thongphitak Sowanna",
    "category": "DeveloperTool",
    "shortDescription": "A local-first desktop REST client.",
    "longDescription": "Compose, send, inspect, organize, and test HTTP API requests without sending workspace data or credentials to a cloud service.",
    "copyright": "Copyright © 2026 Thongphitak Sowanna",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
