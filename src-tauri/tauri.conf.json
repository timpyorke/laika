{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laika",
  "version": "0.1.0",
  "identifier": "com.codenour.laika",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Laika",
        "width": 800,
        "height": 600,
        "backgroundColor": "#05283a"
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Thongphitak Sowanna",
    "category": "DeveloperTool",
    "shortDescription": "A local-first desktop REST client.",
    "longDescription": "Compose, send, inspect, organize, and test HTTP API requests without sending workspace data or credentials to a cloud service.",
    "copyright": "Copyright © 2026 Thongphitak Sowanna",
    "icon": [
      "icons/laika-32.png",
      "icons/laika-128.png",
      "icons/laika-256.png",
      "icons/laika.icns",
      "icons/laika.ico"
    ]
  }
}
